# Copy to .env and export, or set in the shell. Everything is optional; defaults run the mock with no model.

# Which LLM reads free-text notes and polishes reasons: offline (default, no model) | cli (Claude Code CLI, signed in) | api (Anthropic API key)
AUXO_LLM=offline
AUXO_CLI_MODEL=haiku
# AUXO_API_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=

# The built-in scheduler (src/auxocase/service/scheduler.py): on by default under `run.py serve`.
# AUXO_SCHEDULER=on
# Minutes between runs; 0 turns a job off. Defaults: score 5, route 5, touches 1, outreach 1, remind 60, sync 60, monitor 1440, train 43200.
# AUXO_EVERY_SCORE_MIN=5
# AUXO_EVERY_ROUTE_MIN=5
# AUXO_EVERY_TOUCHES_MIN=1
# AUXO_EVERY_OUTREACH_MIN=1
# AUXO_EVERY_REMIND_MIN=60
# AUXO_EVERY_SYNC_MIN=60
# AUXO_EVERY_MONITOR_MIN=1440
# AUXO_EVERY_TRAIN_MIN=43200
# Most changed leads one scoring run reads (Claude takes 10-60 s per lead).
# AUXO_SCORE_BATCH=25
# Most new assignments one outreach run drafts a first email for (Claude takes a few seconds each).
# AUXO_OUTREACH_BATCH=10
# The HubSpot sequence new assignments are enrolled in; step one uses the auxo_email_subject/body tokens. Unset: drafts only.
# AUXO_SEQUENCE_ID=

# The SQLite file (mock HubSpot + service records)
AUXO_DB=data/auxocase.db

# Production only: a HubSpot private-app token switches the service to the real API (unverified; see hubspot/real.py)
# HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_APP_SECRET=      # for X-HubSpot-Signature verification on /webhooks/hubspot
