# Copy to .env and export, or set in the shell. Everything is optional; defaults run the mock with no model.

# Which LLM reads free-text notes and polishes reasons: offline (default, no model) | cli (Claude Code CLI, signed in) | api (Anthropic API key)
AUXO_LLM=offline
# The CLI reader runs on the owner's Claude Code plan, Sonnet or Opus only: Sonnet for the short checked answers
# (signals, reasons, loss reasons), Opus for the emails a lead reads.
AUXO_CLI_MODEL=sonnet
AUXO_CLI_DRAFT_MODEL=opus
# AUXO_API_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=

# The built-in scheduler (src/auxocase/service/scheduler.py): on by default under `run.py serve`.
# AUXO_SCHEDULER=on
# Minutes between runs; 0 turns a job off. Defaults: score 5, rescore 1, route 5, touches 1, outreach 1, remind 60, sync 60, monitor 1440, train 43200.
# AUXO_EVERY_SCORE_MIN=5
# AUXO_EVERY_RESCORE_MIN=1
# AUXO_EVERY_ROUTE_MIN=5
# AUXO_EVERY_TOUCHES_MIN=1
# AUXO_EVERY_OUTREACH_MIN=1
# AUXO_EVERY_REMIND_MIN=60
# AUXO_EVERY_SYNC_MIN=60
# AUXO_EVERY_MONITOR_MIN=1440
# AUXO_EVERY_TRAIN_MIN=43200
# Most changed leads one scoring run reads (Claude takes 10-60 s per lead).
# AUXO_SCORE_BATCH=25
# Most new assignments one outreach run drafts a first email for (Claude takes a few seconds each).
# AUXO_OUTREACH_BATCH=10
# Seconds each rescore run may spend after a model goes live (best-ranked leads first).
# AUXO_RESCORE_BUDGET_S=45
# The HubSpot sequence new assignments are enrolled in; step one uses the auxo_email_subject/body tokens. Unset: drafts only.
# AUXO_SEQUENCE_ID=
# Phase 3: the sequence whose step one SENDS those tokens automatically, for leads below the capacity line (`run.py tier2`).
# Unset: drafts are written to the leads and nothing goes out (the mock logs the send itself).
# AUXO_TIER2_SEQUENCE_ID=

# Cost reporting. The service's Claude calls are metered per call by the Claude CLI and, when Revenium's Claude Code metering
# is set up on this machine (`revenium-metering setup`), sent to Revenium tagged product AuxoCase and the prompt's task.
# A read key (rev_rk_) or write key (rev_sk_) lets `run.py costs --revenium` read the product's cost back; the metering key only sends.
# REVENIUM_API_KEY=

# The SQLite file (mock HubSpot + service records)
AUXO_DB=data/auxocase.db

# Production only: a HubSpot private-app token switches the service to the real API (unverified; see hubspot/real.py)
# HUBSPOT_PRIVATE_APP_TOKEN=
# HUBSPOT_APP_SECRET=      # for X-HubSpot-Signature verification on /webhooks/hubspot; required with the real client
# Host names the pages answer to (default: 127.0.0.1, localhost, [::1]). A deployment lists its own public name here.
# AUXO_ALLOWED_HOSTS=auxo.example.com

# Sending from the lead page (service/mailer.py). Unset, the "Send to <the lead>" button is off.
# AUXO_SMTP_USER=you@gmail.com
# AUXO_SMTP_PASS=                 # a Gmail app password (2-step verification on)
# AUXO_SMTP_HOST=smtp.gmail.com   # and AUXO_SMTP_PORT=587; 465 for SSL
# AUXO_SMTP_FROM=                 # the address on the From line, default the user
# AUXO_SMTP_BCC=                  # HubSpot's logging address, so the portal logs the send
# AUXO_SMTP_TEST_TO=              # every email goes here instead of to the lead, the lead named in the subject
